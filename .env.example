# ============================================================
# Universal AI SEO Platform - Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env.
# ============================================================

# --- Core ---
ENVIRONMENT=development
APP_NAME=Universal AI SEO Platform
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (PostgreSQL, e.g. hosted Supabase) ---
# Get this from Supabase: Project Settings -> Database -> Connection string (URI)
# Example: postgresql://postgres.PROJECT_REF:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/seoplatform

# --- CORS (comma separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Crawler ---
CRAWLER_USER_AGENT=UniversalAI_SEO_Bot/1.0 (+https://example.com/bot)
CRAWLER_MAX_PAGES=100
CRAWLER_DELAY=0.5
# Use "playwright" to enable JS rendering (requires `playwright install chromium`), else "httpx"
CRAWLER_RENDER=httpx
CRAWLER_RENDER_TIMEOUT=15

# --- AI Provider ---
# Options: nvidia | openai | gemini | ollama | none
AI_PROVIDER=none
# Configured model names (read from env, never hard-coded)
AI_MODEL=
AI_SMALL_MODEL=

# NVIDIA Nemotron (OpenAI-compatible API)
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI / any OpenAI-compatible provider
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
# GEMINI_API_KEY=...

# Ollama (local)
# OLLAMA_BASE_URL=http://localhost:11434

# --- Search Engine Connectors (all optional) ---
# Google Search Console OAuth
# GSC_CLIENT_ID=...
# GSC_CLIENT_SECRET=...
# GSC_REFRESH_TOKEN=...
# GSC_SITE=sc-domain:example.com

# Bing Webmaster API
# BING_API_KEY=...

# Brave Search API (official, used for SERP analysis only when configured)
# BRAVE_API_KEY=...

# --- Third-party SERP providers (optional, never fabricated) ---
# SERP_API_PROVIDER=
# SERP_API_KEY=

# --- Supabase (optional, for admin/RLS SQL tooling only) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
